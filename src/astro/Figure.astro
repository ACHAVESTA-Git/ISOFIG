---
import { renderFigure, type FigureSpec } from "isofig";
import "isofig/theme.css";

interface Props {
  spec: FigureSpec;
  lang?: string;
  n?: number | string;
  class?: string;
}

const { spec, lang = "en", n, class: className } = Astro.props;
const figure = renderFigure(spec, { lang, n });
if (figure.errors.length) throw new Error(`isofig «${spec.id}»: ${figure.errors.join("; ")}`);
for (const w of figure.warnings) console.warn(`isofig «${spec.id}»: ${w}`);
---

<div class:list={["isofig-host", className]} set:html={figure.html} />

<script>
  import { mountAll } from "isofig/runtime";

  mountAll();
  document.addEventListener("astro:page-load", () => mountAll());
</script>
